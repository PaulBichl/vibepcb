(kicad_symbol_lib
	(version 20241209)
	(generator "vibepcb")
	(generator_version "probe")
	(symbol "PROBE_OPAMP"
		(exclude_from_sim no)
		(in_bom yes)
		(on_board yes)
		(property "Reference" "U"
			(at -6 7 0)
			(effects (font (size 2.032 2.032)) (justify left bottom))
		)
		(property "Value" ""
			(at 0 0 0)
			(effects (font (size 1.524 1.524)) (hide yes))
		)
		(property "Footprint" "probe:PROBE_SOIC127P600X175-8N"
			(at 0 0 0)
			(effects (font (size 1.524 1.524)) (hide yes))
		)
		(property "Datasheet" "https://example.com/probe.pdf"
			(at 0 0 0)
			(effects (font (size 1.524 1.524)) (hide yes))
		)
		(property "Description" "probe: which fields and visibility survive the import"
			(at 0 0 0)
			(effects (font (size 1.524 1.524)) (hide yes))
		)
		(property "ProbeVisible" "this parameter should be visible"
			(at 0 -10 0)
			(effects (font (size 1.524 1.524)) (justify left))
		)
		(symbol "PROBE_OPAMP_0_1"
			(rectangle
				(start -6 6)
				(end 6 -6)
				(stroke (width 0.254) (type solid))
				(fill (type none))
			)
			(polyline
				(pts (xy -3 3) (xy 3 0) (xy -3 -3) (xy -3 3))
				(stroke (width 0.254) (type solid))
				(fill (type none))
			)
		)
		(symbol "PROBE_OPAMP_1_1"
			(pin input line (at -8 2 0) (length 2)
				(name "+IN" (effects (font (size 1.524 1.524))))
				(number "3" (effects (font (size 1.524 1.524))))
			)
			(pin input line (at -8 -2 0) (length 2)
				(name "-IN" (effects (font (size 1.524 1.524))))
				(number "2" (effects (font (size 1.524 1.524))))
			)
			(pin output line (at 8 0 180) (length 2)
				(name "OUT" (effects (font (size 1.524 1.524))))
				(number "1" (effects (font (size 1.524 1.524))))
			)
			(pin power_in line (at 0 8 270) (length 2)
				(name "V+" (effects (font (size 1.524 1.524))))
				(number "8" (effects (font (size 1.524 1.524))))
			)
			(pin power_in line (at 0 -8 90) (length 2)
				(name "GND" (effects (font (size 1.524 1.524))))
				(number "4" (effects (font (size 1.524 1.524))))
			)
			(pin no_connect line (at 8 4 180) (length 2)
				(name "NC1" (effects (font (size 1.524 1.524))))
				(number "5" (effects (font (size 1.524 1.524))))
			)
			(pin no_connect line (at 8 -4 180) (length 2)
				(name "NC2" (effects (font (size 1.524 1.524))))
				(number "6" (effects (font (size 1.524 1.524))))
			)
			(pin no_connect line (at 8 -2 180) (length 2)
				(name "NC3" (effects (font (size 1.524 1.524))))
				(number "7" (effects (font (size 1.524 1.524))))
			)
		)
		(embedded_fonts no)
	)
)
